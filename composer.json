{
    "name": "hermes/gestao-obras",
    "description": "Sistema de Gestão para Construção Civil - Hermes",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "pestphp/pest": "^2.34"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Config/Database.php",
            "src/Config/App.php",
            "src/Core/Controller.php",
            "src/Core/Model.php",
            "src/Core/Request.php",
            "src/Core/Response.php",
            "src/Core/Session.php",
            "src/Core/Auth.php",
            "src/Core/Validator.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}